{
  "manifest_version": 3,
  "name": "LeetCase",
  "version": "0.3.2",
  "permissions": ["storage"],
  "description": "C++ testcase display and copying with typed values, nested vectors and optional syntax colors. By VoidHub. Independent of LeetCode.",
  "action": {
    "default_title": "LeetCase",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*", "https://www.leetcode.com/problems/*"],
      "js": ["core.js", "highlight.js", "settings.js", "leetcode-adapter.js", "input-view.js", "content.js"],
      "css": ["input-view.css"],
      "run_at": "document_idle"
    }
  ]
}
