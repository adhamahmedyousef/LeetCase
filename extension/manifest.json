{
  "manifest_version": 3,
  "name": "LeetCase",
  "version": "0.2.0",
  "description": "C++ input example formatting and copying, by VoidHub. Early preview for int and vector<int>. Independent of LeetCode.",
  "action": {
    "default_title": "LeetCase",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*", "https://www.leetcode.com/problems/*"],
      "js": ["core.js", "leetcode-adapter.js", "input-view.js", "content.js"],
      "css": ["input-view.css"],
      "run_at": "document_idle"
    }
  ]
}
