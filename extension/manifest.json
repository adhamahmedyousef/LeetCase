{
  "manifest_version": 3,
  "name": "LeetCase",
  "version": "0.5.1",
  "icons": {
    "16": "icons/leetcase.png",
    "32": "icons/leetcase.png",
    "48": "icons/leetcase.png",
    "128": "icons/leetcase.png"
  },
  "permissions": ["storage"],
  "description": "C++, Java and Python testcase formatting and copying. Optional syntax colors. By VoidHub. Independent of LeetCode.",
  "action": {
    "default_title": "LeetCase",
    "default_icon": "icons/leetcase.png",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*", "https://www.leetcode.com/problems/*"],
      "js": ["core.js", "java.js", "highlight.js", "settings.js", "leetcode-adapter.js", "input-view.js", "content.js"],
      "css": ["input-view.css"],
      "run_at": "document_idle"
    }
  ]
}
