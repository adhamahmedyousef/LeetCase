{
  "manifest_version": 3,
  "name": "LeetCase",
  "version": "0.1.0",
  "description": "An open-source testcase display helper by VoidHub. Early preview: connection check only. Independent of LeetCode.",
  "action": {
    "default_title": "LeetCase",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*", "https://www.leetcode.com/problems/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
